<?xml version="1.0"?>
<project xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 
http://maven.apache.org/xsd/maven-4.0.0.xsd" xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <modelVersion>4.0.0</modelVersion>
  
  <parent>
    <groupId>com.github.irybov</groupId>
    <artifactId>bankdemo-cloud</artifactId>
    <version>1.2.5-SNAPSHOT</version>
  </parent>
  
  <artifactId>config</artifactId>
  <packaging>jar</packaging>
  <version>${project.parent.version}</version>
  
  <properties>
    <app.main.class>com.github.irybov.config.App</app.main.class>
  </properties>
  
  <dependencies>
  	<dependency>
      <groupId>org.springframework.cloud</groupId>
      <artifactId>spring-cloud-config-server</artifactId>
	</dependency>
	<dependency>
	    <groupId>org.springframework.boot</groupId>
	    <artifactId>spring-boot-starter-security</artifactId>
	</dependency>
    <dependency>
	    <groupId>org.springframework.boot</groupId>
	    <artifactId>spring-boot-starter-actuator</artifactId>
	</dependency>
  </dependencies>
  
    <build>
        <plugins>
            <plugin>
                <groupId>com.google.cloud.tools</groupId>
    <artifactId>jib-maven-plugin</artifactId>
    <version>3.5.2</version>
    <configuration>
        <from>
            <image>bellsoft/liberica-runtime-container:jre-25-slim-glibc</image>
        </from>
        <to>
            <image>bankdemo-cloud-config</image>
            <tags>
<!--                <tag>${project.version}</tag>-->
                <tag>latest</tag>
            </tags>
        </to>
        <container>
            <workingDirectory>/app</workingDirectory>
            <ports>
                <port>8888</port>
            </ports>
            <entrypoint>
                <arg>sh</arg>
                <arg>-c</arg>
                <arg>exec java $JAVA_OPTS -Dspring.cloud.config.server.native.searchLocations="$SPRING_CONFIG_SERVER_NATIVE_SEARCH_LOCATIONS" -cp /app/resources:/app/classes:/app/libs/* ${app.main.class}</arg>
            </entrypoint>
        </container>
        <extraDirectories>
            <paths>
                <path>
                    <from>src/main/resources/configs</from>
                    <into>/app/configs</into>
                </path>
            </paths>
        </extraDirectories>
    </configuration>
            </plugin>
        </plugins>
    </build>
  
</project>
